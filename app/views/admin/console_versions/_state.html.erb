<%# The same three states bin/rails console:status prints. %>
<% if !version.available? %>
  <span class="state state-bad">no library files</span>
<% elsif !version.library.label_matches_contents? %>
  <span class="state state-warn">mislabelled &mdash; says <%= version.library.declared_version.presence || "nothing" %></span>
<% else %>
  <span class="state state-ok">ok</span>
<% end %>
