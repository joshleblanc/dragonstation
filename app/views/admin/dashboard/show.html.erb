<% content_for :title, "Admin" %>

<div class="admin-head">
  <div>
    <h1>Overview</h1>
    <p class="lede">Everything on this site hangs off a console library.</p>
  </div>
  <%= link_to "Upload a console library", new_admin_console_version_path, class: "secondary" %>
</div>

<dl class="stat-grid">
  <div class="stat">
    <dt>Users</dt>
    <dd><%= @users %></dd>
  </div>
  <div class="stat">
    <dt>Cartridges</dt>
    <dd><%= @cartridges %></dd>
  </div>
  <div class="stat">
    <dt>Published</dt>
    <dd><%= @published %></dd>
  </div>
  <div class="stat">
    <dt>Console versions</dt>
    <dd><%= @versions.size %></dd>
  </div>
</dl>

<%# A site with no usable library cannot accept an upload at all, and an upload
    form that rejects its own submission is a bad way to find that out. %>
<% if @versions.empty? %>
  <div class="admin-caution">
    <p><strong>No console library is installed.</strong></p>
    <p>Uploads will be refused until one is &mdash; a cartridge has nothing to build
      against. Add one under <code>vendor/console/</code> and run
      <code>bin/rails console:install</code>, or upload a ZIP.</p>
  </div>
<% elsif @unusable.any? %>
  <div class="admin-caution">
    <p><strong><%= pluralize(@unusable.size, "version") %> cannot be served.</strong></p>
    <p>
      <%= @unusable.map(&:version).to_sentence %>
      <%= "has" %> a missing directory under <code>vendor/console/</code>. Every
      cartridge pinned to <%= "it" %> will fail to boot. See
      <%= link_to "the console library", admin_console_versions_path %>.
    </p>
  </div>
<% end %>

<div class="admin-section">
  <h2>Console library</h2>

  <table class="admin-table">
    <thead>
      <tr>
        <th>Version</th>
        <th>State</th>
        <th class="num">Pinned cartridges</th>
      </tr>
    </thead>
    <tbody>
      <% @versions.each do |version| %>
        <tr>
          <td>
            <%= link_to version.version, admin_console_version_path(version) %>
            <% if version == @default %><span class="state state-ok">default</span><% end %>
          </td>
          <td><%= render "admin/console_versions/state", version: version %></td>
          <td class="num"><%= version.cartridges.size %></td>
        </tr>
      <% end %>

      <% if @versions.empty? %>
        <tr><td colspan="3" class="muted">Nothing installed.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>