<% content_for :title, "Console library" %>

<div class="page-head">
  <h1>The console library</h1>
  <p class="lede">
    Everything you need to write a cart and publish it here. A cart never has to
    include the library: the site supplies it whenever the cart runs.
    These docs cover console <%= @console_version.version %><%= ", the version new uploads are pinned to" if @console_version.default? %>.
  </p>
</div>

<%# The contents, because a manual that is six sections long needs a way in
    that is not scrolling. %>
<nav class="doc-toc" aria-label="Contents">
  <ul>
    <% @guide.sections.each_with_index do |section, i| %>
      <li><%= link_to "#{i + 1}. #{section[:title]}", "##{section[:id]}" %></li>
    <% end %>
  </ul>
</nav>

<section class="doc-section" id="start">
  <h2><span class="doc-num">1.</span> Getting started</h2>
  <p>
    A cart is a folder inside the console's <code>carts/</code> folder. It holds
    one Ruby class, plus any art, sound and data the cart uses:
  </p>
  <pre class="source layout"><%= raw FileHighlighter.new("layout.txt", @guide.layout[:tree]).call %></pre>
  <%= doc_prose(@guide.layout[:rule], class_name: "doc-rule") %>

  <p>
    To run carts on your own machine you need
    <a href="https://dragonruby.org">DragonRuby</a> and the console. Make a folder
    for the console inside your DragonRuby folder, next to the
    <code>dragonruby</code> program, and unzip the download into it. Then create
    <code>carts/mine/app/</code> inside it for the examples below.
  </p>
  <p>
    <% if authenticated? %>
      <%= link_to "Download the console with my publishing key", console_bundle_path, class: "button-link" %>
      <span class="muted">or <%= link_to "download it without a key", library_download_path %></span>
    <% else %>
      <%= link_to "Download the console", library_download_path, class: "button-link" %>
      <span class="muted">
        &mdash; <%= link_to "sign in", new_session_path %> first to get a download
        that includes a key for publishing carts from the console.
      </span>
    <% end %>
  </p>
</section>

<section class="doc-section" id="first-cart">
  <h2><span class="doc-num">2.</span> Your first cart</h2>
  <p>
    Five complete carts, each adding one idea to the one before. Save each over
    <code>carts/mine/app/mine.rb</code> and run it from the console folder with:
  </p>
  <pre class="source">./bin/run mine</pre>
  <% @guide.samples.each do |sample| %>
    <div class="doc-sample" id="<%= sample.id %>">
      <h3><%= sample.title %></h3>
      <p class="doc-path">
        <%= sample.verb %> <code><%= sample.file %></code>
      </p>
      <%= doc_prose(sample.note) %>
      <pre class="source"><%= raw FileHighlighter.new("sample.rb", sample.code).call %></pre>
    </div>
  <% end %>
</section>

<section class="doc-section" id="publishing">
  <h2><span class="doc-num">3.</span> Publishing a cart</h2>
  <p>
    You don't need to build an archive or use the upload form. Once the bundle is
    unpacked with your key in it, run this from the console folder:
  </p>
  <pre class="source">./bin/publish-site mine</pre>

  <ol class="doc-steps">
    <% @guide.publishing[:steps].each do |step| %>
      <li><%= doc_inline(step) %></li>
    <% end %>
  </ol>

  <p class="muted">
    This is the same upload as the web form, without the browser, and it runs the
    same checks. Archives with path traversal, symlinks or ZIP bombs are rejected,
    and so is a cart whose code names a file under <code>sprites/</code>,
    <code>sounds/</code>, <code>maps/</code> or <code>data/</code> that the cart
    does not include. The error message says which check failed.
  </p>

  <details class="doc-endpoint">
    <summary>The API endpoint, for writing your own client</summary>
    <pre class="source"><%= raw FileHighlighter.new("client.rb", @guide.publishing[:endpoint].join("\n")).call %></pre>
  </details>
</section>

<section class="doc-section" id="primer">
  <h2><span class="doc-num">4.</span> Ruby primer</h2>
  <p class="muted">
    Carts are written in Ruby. This section covers just the parts of the
    language a cart needs.
  </p>
  <% @guide.primer.each do |topic| %>
    <div class="doc-topic">
      <h3><%= topic.title %></h3>
      <%= doc_prose(topic.prose) %>
      <% if topic.list.present? %>
        <ul class="doc-list">
          <% topic.list.each do |item| %><li><%= doc_inline(item) %></li><% end %>
        </ul>
      <% end %>
      <% if topic.code.present? %>
        <pre class="source"><%= raw FileHighlighter.new("primer.rb", topic.code).call %></pre>
      <% end %>
    </div>
  <% end %>
</section>

<section class="doc-section" id="structure">
  <h2><span class="doc-num">5.</span> Cart structure</h2>
  <p class="muted">
    What the console does with your cart, and in what order. The API reference
    explains each method; this section explains when they are called.
  </p>

  <% @guide.structure.each do |topic| %>
    <div class="doc-topic">
      <h3><%= topic.title %></h3>
      <%= doc_prose(topic.prose) %>
      <% if topic.list.present? %>
        <ul class="doc-list">
          <% topic.list.each do |item| %><li><%= doc_inline(item) %></li><% end %>
        </ul>
      <% end %>
      <% if topic.code.present? %>
        <pre class="source"><%= raw FileHighlighter.new("structure.rb", topic.code).call %></pre>
      <% end %>
    </div>
  <% end %>

  <div class="doc-topic">
    <h3>The hooks</h3>
    <%= doc_prose("Every hook is optional. A cart that defines none of them still boots; it just does nothing.") %>
    <table class="doc-table">
      <thead>
        <tr><th>Hook</th><th>When it runs</th><th>What it is for</th></tr>
      </thead>
      <tbody>
        <% @guide.hooks.each do |hook| %>
          <tr>
            <td><code><%= hook[:name] %></code></td>
            <td class="doc-when"><%= hook[:when] %></td>
            <td><%= doc_inline(hook[:note]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="doc-section" id="reference">
  <h2><span class="doc-num">6.</span> API reference</h2>
  <p>
    The library has <%= pluralize(@modules.size, "module") %>. Every description
    comes from the comments in the library's source, so it stays in sync with the
    code; only the grouping below is written by hand.
  </p>
  <p class="muted">
    Each method links to its full documentation.
  </p>

  <% @guide.groups(@modules).each do |group| %>
    <div class="doc-subsystem">
      <h3><%= group[:title] %></h3>
      <p class="muted"><%= doc_inline(group[:note]) %></p>

      <% group[:modules].each do |mod| %>
        <div class="doc-apimodule">
          <h4><%= link_to mod.name, doc_path(mod.slug) %></h4>
          <p class="doc-index-summary"><%= doc_summary(mod) %></p>
          <ul class="doc-signatures">
            <% mod.sections.flat_map(&:methods).each do |method| %>
              <li>
                <%= link_to method.signature, doc_path(mod.slug, anchor: mod.anchor_for(method)) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
