<% content_for :title, "Console library" %>

<div class="page-head">
  <h1>The console library</h1>
  <p class="lede">
    Everything you need to write a cart for this site. The console runs 60
    times a second and the library travels with your upload, so nothing here
    needs installing and nothing needs requiring.
    This is console <%= @console_version.version %><%= ", the version a new upload is pinned to" if @console_version.default? %>.
  </p>
</div>

<%# The contents, because a manual that is six sections long needs a way in
    that is not scrolling. %>
<nav class="doc-toc" aria-label="Contents">
  <ul>
    <% @guide.sections.each_with_index do |section, i| %>
      <li><%= link_to "#{i + 1}. #{section[:title]}", "##{section[:id]}" %></li>
    <% end %>
  </ul>
</nav>

<section class="doc-section" id="start">
  <h2><span class="doc-num">1.</span> Getting started</h2>
  <p>
    Your cart is a folder. One Ruby file inside it defines a class, and that class
    is the cart. Art and data go in folders of their own. Zip the cart folder and
    upload it.
  </p>
  <pre class="source layout"><%= raw FileHighlighter.new("layout.txt", @guide.layout[:tree]).call %></pre>
  <%= doc_prose(@guide.layout[:rule], class_name: "doc-rule") %>

  <p>
    You need the console to boot a cart. The download holds the library and the
    tool that boots it, so unpack the download over a checkout and you can run one.
  </p>
  <p>
    <% if authenticated? %>
      <%= link_to "Download it with my publishing key", console_bundle_path, class: "button-link" %>
      <span class="muted">or <%= link_to "just the library", library_download_path %></span>
    <% else %>
      <%= link_to "Download the library", library_download_path, class: "button-link" %>
      <span class="muted">
        &mdash; <%= link_to "sign in", new_session_path %> to download it with a
        key that lets you publish carts from the console.
      </span>
    <% end %>
  </p>
</section>

<section class="doc-section" id="first-cart">
  <h2><span class="doc-num">2.</span> Your first cart</h2>
  <p class="muted">
    Five examples, each one building on the last. They all go in the same file.
  </p>
  <% @guide.samples.each do |sample| %>
    <div class="doc-sample" id="<%= sample.id %>">
      <h3><%= sample.title %></h3>
      <p class="doc-path">
        <%= sample.verb %> <code><%= sample.file %></code>
      </p>
      <%= doc_prose(sample.note) %>
      <pre class="source"><%= raw FileHighlighter.new("sample.rb", sample.code).call %></pre>
    </div>
  <% end %>
</section>

<section class="doc-section" id="publishing">
  <h2><span class="doc-num">3.</span> Sending a cart here</h2>
  <p>
    No archive to build and no upload form. With the bundle unpacked and your key
    in it:
  </p>
  <pre class="source">./bin/publish-site arcade</pre>

  <ol class="doc-steps">
    <% @guide.publishing[:steps].each do |step| %>
      <li><%= doc_inline(step) %></li>
    <% end %>
  </ol>

  <p class="muted">
    The same upload, without the browser. Traversal, symlinks and expansion bombs
    are refused, as is art a cart names but does not own. The message says which one.
  </p>

  <details class="doc-endpoint">
    <summary>The endpoint, if you are writing your own client</summary>
    <pre class="source"><%= raw FileHighlighter.new("client.rb", @guide.publishing[:endpoint].join("\n")).call %></pre>
  </details>
</section>

<section class="doc-section" id="primer">
  <h2><span class="doc-num">4.</span> Ruby primer</h2>
  <p class="muted">
    A cart is written in Ruby. This is the part of the language a cart needs,
    and nothing more.
  </p>
  <% @guide.primer.each do |topic| %>
    <div class="doc-topic">
      <h3><%= topic.title %></h3>
      <%= doc_prose(topic.prose) %>
      <% if topic.list.present? %>
        <ul class="doc-list">
          <% topic.list.each do |item| %><li><%= doc_inline(item) %></li><% end %>
        </ul>
      <% end %>
      <% if topic.code.present? %>
        <pre class="source"><%= raw FileHighlighter.new("primer.rb", topic.code).call %></pre>
      <% end %>
    </div>
  <% end %>
</section>

<section class="doc-section" id="structure">
  <h2><span class="doc-num">5.</span> Cart structure</h2>
  <p class="muted">
    What the console does with your cart, and in what order. The API reference
    says what each method does; this says what happens around them.
  </p>

  <% @guide.structure.each do |topic| %>
    <div class="doc-topic">
      <h3><%= topic.title %></h3>
      <%= doc_prose(topic.prose) %>
      <% if topic.list.present? %>
        <ul class="doc-list">
          <% topic.list.each do |item| %><li><%= doc_inline(item) %></li><% end %>
        </ul>
      <% end %>
      <% if topic.code.present? %>
        <pre class="source"><%= raw FileHighlighter.new("structure.rb", topic.code).call %></pre>
      <% end %>
    </div>
  <% end %>

  <div class="doc-topic">
    <h3>The hooks</h3>
    <%= doc_prose("Every hook is optional. A cart that defines none of them still boots, and does nothing.") %>
    <table class="doc-table">
      <tbody>
        <% @guide.hooks.each do |hook| %>
          <tr>
            <td><code><%= hook[:name] %></code></td>
            <td class="doc-when"><%= hook[:when] %></td>
            <td><%= doc_inline(hook[:note]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="doc-section" id="reference">
  <h2><span class="doc-num">6.</span> API reference</h2>
  <p>
    <%= pluralize(@modules.size, "module") %>. Every description is read out of the
    library's own comments, so it stays true of the code. Only the grouping is
    written by hand.
  </p>
  <p class="muted">
    Each method links to where it is documented in full.
  </p>

  <% @guide.groups(@modules).each do |group| %>
    <div class="doc-subsystem">
      <h3><%= group[:title] %></h3>
      <p class="muted"><%= doc_inline(group[:note]) %></p>

      <% group[:modules].each do |mod| %>
        <div class="doc-apimodule">
          <h4><%= link_to mod.name, doc_path(mod.slug) %></h4>
          <p class="doc-index-summary"><%= doc_summary(mod) %></p>
          <ul class="doc-signatures">
            <% mod.sections.flat_map(&:methods).each do |method| %>
              <li>
                <%= link_to method.signature, doc_path(mod.slug, anchor: mod.anchor_for(method)) %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
