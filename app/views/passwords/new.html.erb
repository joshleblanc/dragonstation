<% content_for :title, "Forgot your password" %>

<div class="auth-card">
  <h1>Forgot your password?</h1>
  <p class="lede">
    We'll email you a link to set a new one.
  </p>

  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>
    </div>

    <%= form.submit "Email reset instructions" %>
  <% end %>

  <p class="auth-alt">
    <%= link_to "Back to sign in", new_session_path %> &middot;
    <%= link_to "Create an account", new_registration_path %>
  </p>
</div>